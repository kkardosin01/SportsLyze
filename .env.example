# ============================================================================
# SportsLyze — Variáveis de ambiente (copie para .env e preencha)
# ============================================================================

# --- Supabase ---
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=changeme
SUPABASE_JWT_SECRET=changeme
SUPABASE_STORAGE_BUCKET_VIDEOS=videos
SUPABASE_STORAGE_BUCKET_CLIPS=clips
SUPABASE_STORAGE_BUCKET_REPORTS=reports

# --- Fila (Redis/Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Upload ---
MAX_UPLOAD_SIZE_BYTES=8589934592
VIDEO_RETENTION_DAYS_DEFAULT=15

# --- E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@sportslyze.com.br

# --- App ---
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Web (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=changeme
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Mobile (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=changeme
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
